parameters:
  level: 8
  scanDirectories:
    #- %currentWorkingDirectory%/bin/.phpunit
  paths:
    - %currentWorkingDirectory%/app
    - %currentWorkingDirectory%/domains
    - %currentWorkingDirectory%/tests
  reportUnmatchedIgnoredErrors: false
  fileExtensions:
    - php
  excludePaths:
    analyse:
      - domains/Telegram/Presentation/Routes/api.php
      - vendor/*
    analyseAndScan:
      - app
  ignoreErrors:
  		-
  			identifier: missingType.iterableValue
